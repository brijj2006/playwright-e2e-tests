{
  "name": "playwright-e2e-tests",
  "version": "1.0.0",
  "description": "playwright e2e tests with AI capability",
  "license": "ISC",
  "author": "bridge automation",
  "type": "module",
  "main": "hello.js",
  "scripts": {
    "demo": "npx playwright test tests/demo/mytest.spec.ts --headed",
    "make-aptmnt": "npx playwright test tests/functional/make.aptmnt.spec.ts --headed",
    "inventory": "npx playwright test tests/functional/inventory.spec.ts --headed",
    "tag": "npx playwright test --headed --grep @demo",
    "allure:generate": "npx allure generate allure-results --clean -o allure-report",
    "allure:open": "npx allure open allure-report",
    "allure:serve": "npx allure serve allure-results",
    "mock:test": "npx playwright test --headed --grep=@mock"
  },
  "devDependencies": {
    "@faker-js/faker": "^10.4.0",
    "@playwright/test": "^1.59.1",
    "@types/node": "^25.6.0",
    "ajv": "^8.20.0",
    "allure-commandline": "^2.40.0",
    "allure-playwright": "^3.7.2"
  }
}
